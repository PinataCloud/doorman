{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:doorman:schemas:ledger-export.v1",
  "title": "Doorman Event Ledger export",
  "description": "Agent sessions and their turns on this computer. Masked: turn text is redacted and removed values appear as fingerprints.",
  "type": "object",
  "required": [
    "schema",
    "schema_version",
    "generated_at",
    "app_version",
    "sessions"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "urn:doorman:schemas:ledger-export.v1"
    },
    "schema_version": {
      "const": 1
    },
    "generated_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the file was written."
    },
    "app_version": {
      "type": "string",
      "description": "The app that wrote it."
    },
    "sessions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/session"
      }
    }
  },
  "$defs": {
    "turn": {
      "type": "object",
      "description": "One prompt or model turn.",
      "required": [
        "id",
        "source",
        "session_id",
        "role",
        "at"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "description": "Stable turn id.",
          "minLength": 1
        },
        "source": {
          "type": "string",
          "description": "The capture rail.",
          "minLength": 1
        },
        "session_id": {
          "type": "string",
          "description": "The session it belongs to."
        },
        "role": {
          "type": "string",
          "enum": [
            "user",
            "assistant"
          ]
        },
        "at": {
          "type": "string",
          "format": "date-time",
          "description": "When it happened."
        },
        "model": {
          "type": "string",
          "description": "The model that answered."
        },
        "usage": {
          "type": "object",
          "required": [
            "input_tokens",
            "output_tokens",
            "cache_read_tokens",
            "cache_write_tokens",
            "cache_write_1h_tokens",
            "web_search_requests"
          ],
          "additionalProperties": false,
          "properties": {
            "input_tokens": {
              "type": "integer",
              "minimum": 0,
              "description": "Input tokens."
            },
            "output_tokens": {
              "type": "integer",
              "minimum": 0,
              "description": "Output tokens."
            },
            "cache_read_tokens": {
              "type": "integer",
              "minimum": 0,
              "description": "Cache-read tokens."
            },
            "cache_write_tokens": {
              "type": "integer",
              "minimum": 0,
              "description": "Cache-write tokens."
            },
            "cache_write_1h_tokens": {
              "type": "integer",
              "minimum": 0,
              "description": "Of which 1-hour-TTL cache writes."
            },
            "web_search_requests": {
              "type": "integer",
              "minimum": 0,
              "description": "Web searches."
            }
          }
        },
        "cost": {
          "type": "number",
          "minimum": 0,
          "description": "USD from the local pricing table; absent when the model is unpriced."
        },
        "cost_unknown": {
          "type": "boolean"
        },
        "reported_cost": {
          "type": "number",
          "minimum": 0,
          "description": "A provider-reported charge."
        },
        "usage_incomplete": {
          "type": "boolean"
        },
        "settlement": {
          "type": "string",
          "enum": [
            "subscription",
            "credits",
            "billed",
            "unknown"
          ]
        },
        "text": {
          "type": "string",
          "description": "The turn's text, redacted: a removed value reads `[redacted:<family>]`. `[redacted:cut]` is the final word of a turn cut at the 4,000-character cap, masked in case the cut went through a secret; it is not a detection."
        },
        "text_redacted": {
          "type": "boolean",
          "description": "Redaction changed this turn's text."
        },
        "secrets": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "label",
              "length",
              "fingerprint"
            ],
            "additionalProperties": false,
            "properties": {
              "label": {
                "type": "string",
                "description": "The redaction family; empty for an anonymous value."
              },
              "length": {
                "type": "integer",
                "minimum": 0,
                "description": "Characters in the value."
              },
              "fingerprint": {
                "type": "string",
                "description": "HMAC-SHA256 under this machine's vault key, 16 hex characters — matches the detections export.",
                "pattern": "^[0-9a-f]{16}$"
              },
              "primary": {
                "type": "boolean"
              }
            }
          },
          "description": "The values redaction removed, as fingerprints. A `[redacted:cut]` word is not listed."
        },
        "tools": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "cwd": {
          "type": "string",
          "description": "Working directory."
        },
        "git_branch": {
          "type": "string",
          "description": "Git branch."
        }
      }
    },
    "session": {
      "type": "object",
      "description": "One agent session, as the Event Ledger shows it.",
      "required": [
        "id",
        "source",
        "cost",
        "turns",
        "prompts",
        "started_at",
        "ended_at",
        "detection_ids",
        "items"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "description": "Session id.",
          "minLength": 1
        },
        "source": {
          "type": "string",
          "description": "The capture rail."
        },
        "title": {
          "type": "string",
          "description": "The session's title."
        },
        "title_origin": {
          "type": "string",
          "enum": [
            "auto_prompt",
            "auto_summary"
          ]
        },
        "cost": {
          "type": "number",
          "minimum": 0,
          "description": "Priced USD across the session."
        },
        "cost_unknown_turns": {
          "type": "integer",
          "minimum": 0,
          "description": "Turns with an unpriced model."
        },
        "input_tokens": {
          "type": "integer",
          "minimum": 0,
          "description": "Input tokens."
        },
        "output_tokens": {
          "type": "integer",
          "minimum": 0,
          "description": "Output tokens."
        },
        "cache_read_tokens": {
          "type": "integer",
          "minimum": 0,
          "description": "Cache-read tokens."
        },
        "cache_write_tokens": {
          "type": "integer",
          "minimum": 0,
          "description": "Cache-write tokens."
        },
        "turns": {
          "type": "integer",
          "minimum": 0,
          "description": "Turns in the session."
        },
        "prompts": {
          "type": "integer",
          "minimum": 0,
          "description": "Prompts in the session."
        },
        "models": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "started_at": {
          "type": "string",
          "format": "date-time",
          "description": "First turn."
        },
        "ended_at": {
          "type": "string",
          "format": "date-time",
          "description": "Newest turn."
        },
        "cwd": {
          "type": "string",
          "description": "Working directory."
        },
        "git_branch": {
          "type": "string",
          "description": "Git branch."
        },
        "task": {
          "type": "string",
          "description": "The use-case classification."
        },
        "covered_cost": {
          "type": "number",
          "minimum": 0,
          "description": "Plan-covered USD."
        },
        "overage_cost": {
          "type": "number",
          "minimum": 0,
          "description": "Credits USD."
        },
        "billed_cost": {
          "type": "number",
          "minimum": 0,
          "description": "API-metered USD."
        },
        "unknown_cost": {
          "type": "number",
          "minimum": 0,
          "description": "Unattributed USD."
        },
        "covered_tokens": {
          "type": "integer",
          "minimum": 0,
          "description": "Plan-covered input+output tokens."
        },
        "overage_tokens": {
          "type": "integer",
          "minimum": 0,
          "description": "Input+output tokens settled on API credits."
        },
        "billed_tokens": {
          "type": "integer",
          "minimum": 0,
          "description": "Input+output tokens metered to an API key."
        },
        "unknown_tokens": {
          "type": "integer",
          "minimum": 0,
          "description": "Unattributed input+output tokens."
        },
        "alerts": {
          "type": "integer",
          "minimum": 0,
          "description": "Open detections anchored here."
        },
        "last_role": {
          "type": "string",
          "enum": [
            "user",
            "assistant"
          ]
        },
        "last_turn_tools": {
          "type": "integer",
          "minimum": 0,
          "description": "Tool calls in the newest turn."
        },
        "resume_command": {
          "type": "string",
          "description": "The host's resume command."
        },
        "detection_ids": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "`finding_id`s of the detections anchored to this session — the records are in the detections export."
        },
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/turn"
          },
          "description": "The session's turns, oldest first."
        }
      }
    }
  }
}
